{
  "expo": {
    "name": "sanket-app",
    "slug": "sanket-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sanketapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fanfeed.sanketapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "SANKET needs the camera to photograph a burn or wound for first-aid guidance.",
          "photosPermission": "SANKET needs access to your photos so you can choose a burn or wound picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SANKET uses your location to show nearby help and file your incident."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
